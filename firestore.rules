rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function roleIs(roles) { return signedIn() && profile().active != false && profile().role in roles; }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if roleIs(['admin']);
      allow delete: if roleIs(['admin']) && uid != request.auth.uid;
    }
    match /auditLogs/{id} { allow read: if roleIs(['admin','manager']); allow create: if signedIn(); allow update, delete: if false; }
    match /{collectionName}/{id} {
      allow read: if signedIn();
      allow create, update: if roleIs(['admin','manager','officer']);
      allow delete: if roleIs(['admin','manager']);
    }
  }
}
